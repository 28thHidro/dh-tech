# Copy file này thành .env rồi điền giá trị thật.
# File .env chứa mật khẩu, đã được .gitignore chặn, KHÔNG commit lên GitHub.

# Chuỗi kết nối Neon: vào Neon -> nút Connect -> copy
DATABASE_URL=postgresql://USER:PASSWORD@HOST.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Cổng chạy server trên máy
PORT=3000

# Khoá bí mật để ký token đăng nhập admin (ít nhất 32 ký tự ngẫu nhiên).
# Tạo bằng lệnh:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cloudinary: Dashboard -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Địa chỉ website được phép gọi API, cách nhau dấu phẩy. Để trống khi chạy trên máy.
# Trên Render: https://dh-tech-frontend.vercel.app
CORS_ORIGIN=
