# Copy file này thành .env rồi điền giá trị thật.
# File .env chứa mật khẩu, đã được .gitignore chặn, KHÔNG commit lên GitHub.

# Chuỗi kết nối Neon: vào Neon -> nút Connect -> copy
DATABASE_URL=postgresql://USER:PASSWORD@HOST.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Cổng chạy server trên máy
PORT=3000
